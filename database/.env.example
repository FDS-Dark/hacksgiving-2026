POSTGRES_PORT=5432
POSTGRES_USER=hacksgiving_owner
POSTGRES_PASSWORD=hacksgiving_owner
POSTGRES_DB=hacksgiving
PGDATA=/var/lib/postgresql/data/pgdata

# ./migrate.sh connects as the schema owner above.
HACKSGIVING_MIGRATION_DATABASE_URL=postgresql://hacksgiving_owner:hacksgiving_owner@localhost:5432/hacksgiving
# The API's role, created by revision 0002. Must match APP__DATABASE__USERNAME
# and APP__DATABASE__PASSWORD in api/.env.
HACKSGIVING_APP_ROLE=hacksgiving
HACKSGIVING_APP_PASSWORD=change-me-too
