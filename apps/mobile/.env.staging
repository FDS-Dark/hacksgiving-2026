# Values for the "Hacksgiving Staging" app (APP_VARIANT=staging), loaded by
# scripts/variant.sh staging. Committed on purpose: EXPO_PUBLIC_* values are
# bundled into the app and are public identifiers, not secrets.
#
# Expo doesn't load this file itself (it only knows .env.development and
# .env.production). variant.sh exports these values into the shell, and
# shell values win over every .env file, .env.local included.
APP_VARIANT=staging
EXPO_PUBLIC_API_BASE_URL=https://hacksgiving-api-staging.austinkoske.com/v1
# Cooli's tenant, and the same build client and audience as production
# (auth0/terraform output mobile_env); the client allows hacksgiving-staging://auth.
EXPO_PUBLIC_AUTH0_DOMAIN=dev-3wpn13zh30l6orpi.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=rQgDjZXvTTduGo83EIoAwbAXiccht63F
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.hacksgiving.app
EXPO_PUBLIC_DEV_ACCESS_TOKEN=
