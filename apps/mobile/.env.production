# Values for Release builds (`npx expo run:ios --configuration Release`,
# Xcode Archive). Committed on purpose: EXPO_PUBLIC_* values are bundled into
# the app and are public identifiers, not secrets.
#
# Auth0: Hacksgiving Mobile in Cooli's tenant (auth0/terraform output mobile_env).
#
# Expo loads .env.local over this file, so a Release build on a machine with
# a .env.local uses that instead. Build on a clean clone (or move .env.local
# aside) to get production.
EXPO_PUBLIC_API_BASE_URL=https://hacksgiving-api.austinkoske.com/v1
EXPO_PUBLIC_AUTH0_DOMAIN=dev-3wpn13zh30l6orpi.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=rQgDjZXvTTduGo83EIoAwbAXiccht63F
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.hacksgiving.app
