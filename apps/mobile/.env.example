# Copy to .env.local (gitignored). EXPO_PUBLIC_* values are bundled into the
# app, so never put a secret here. Restart `npx expo start` after editing.
#
# The API, as the phone sees it: use your computer's LAN or Tailscale IP,
# not localhost, when running on a physical iPhone through Expo Go.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# ── Auth0 (design §4.3) ─────────────────────────────────────────────────────
# Managed in auth0/terraform; `tofu -chdir=../../auth0/terraform output -raw
# mobile_env` prints all three. Public identifiers, not secrets.
#   DOMAIN    your tenant, e.g. hacksgiving.us.auth0.com (no https://)
#   CLIENT_ID the Native application's client id
#   AUDIENCE  the Auth0 API identifier; must equal APP__JWT__AUDIENCE in api/.env
# The sign-in screen shows the callback URL to allow-list (dev builds only).
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=

# ── Local dev without Auth0 ─────────────────────────────────────────────────
# Paste the output of `uv run python scripts/dev_token.py` from api/ to get a
# "Continue with dev token" button. Only works against an API with no
# APP__JWT__JWKS_URL. Leave empty once Auth0 is set up.
EXPO_PUBLIC_DEV_ACCESS_TOKEN=

# Dev only: 1 skips sign-in so you can work on screens without Auth0.
EXPO_PUBLIC_SKIP_AUTH=
