# Values for the staging website (web.Dockerfile, CI build-web-staging).
# Committed on purpose: EXPO_PUBLIC_* values are bundled into the app and are
# public identifiers, not secrets. Same API and tenant as .env.staging, but
# the Hacksgiving Mobile (dev) client, the one that allows browser sign-in
# from https://hacksgiving-staging.austinkoske.com (auth0/terraform
# dev_web_origins).
EXPO_PUBLIC_API_BASE_URL=https://hacksgiving-api-staging.austinkoske.com/v1
EXPO_PUBLIC_AUTH0_DOMAIN=dev-3wpn13zh30l6orpi.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=U218lvdCzEBESk0teqWgIIBqiTXL9Exo
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.hacksgiving.app
