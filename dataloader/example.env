# The data loader's local settings (docs/data-loader.md). scripts/dev-setup.sh
# copies this to dataloader/.env and fills the database settings from
# api/.env. In Kubernetes they come from the pod's environment instead
# (terraform/loader.tf); no .env goes into the image.

# Database: the same as the API's (APP__DATABASE__* in api/.env).
APP__DATABASE__HOST=localhost
APP__DATABASE__PORT=5432
APP__DATABASE__NAME=hacksgiving
APP__DATABASE__USERNAME=hacksgiving
APP__DATABASE__PASSWORD=change-me-too
APP__DATABASE__SSL=disable
APP__DATABASE__PREPARED_STATEMENTS=true

APP__ENVIRONMENT__NAME=dev
# APP__LOGGING__LEVEL=INFO
# APP__LOGGING__FORMAT=text

# Each source is skipped until it has credentials; the CareerOneStop
# directory downloads need none.
# USAJOBS: request a key at developer.usajobs.gov; the email is the one you
# requested it with.
APP__LOADER__USAJOBS_API_KEY=
APP__LOADER__USAJOBS_EMAIL=
# CareerOneStop Web API (jobs and training programs). New registrations were
# closed in November 2026.
APP__LOADER__CAREERONESTOP_USER_ID=
APP__LOADER__CAREERONESTOP_TOKEN=
# Optional: an api.data.gov key for the FBI Crime Data Explorer (it answers
# without one too).
APP__LOADER__FBI_API_KEY=
# APP__LOADER__LOCATION=Milwaukee, WI
# APP__LOADER__RADIUS_MILES=25

# MPD's calls page allows 10 requests per 30 minutes per IP address, shared
# by production (300 s), staging (3600 s) and every laptop on the home
# network. Locally the loader asks at most every 15 minutes, and waits half
# an hour after MPD refuses.
# APP__LOADER__MPD_MIN_INTERVAL_SECONDS=900
# APP__LOADER__MPD_BACKOFF_SECONDS=1800
# Seconds between --watch rounds of the live sources (MFD calls, transit and
# weather alerts; MPD whenever its interval allows).
# APP__LOADER__LIVE_EVERY_SECONDS=300
