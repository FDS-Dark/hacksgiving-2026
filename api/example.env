# Database. Local dev: the database/ compose stack. Supabase: the project's
# direct (5432) or session-pooler host, SSL=require. Through the transaction
# pooler (6543), also set PREPARED_STATEMENTS=false.
APP__DATABASE__HOST=localhost
APP__DATABASE__PORT=5432
APP__DATABASE__NAME=hacksgiving
APP__DATABASE__USERNAME=hacksgiving
APP__DATABASE__PASSWORD=change-me-too
APP__DATABASE__SSL=disable
APP__DATABASE__PREPARED_STATEMENTS=true

# Access-token verification — see api/settings.py:JWTConfig.
# Local dev: leave JWKS_URL empty; tokens are HS256-signed with SECRET
# (see "Dev tokens" in api/README.md).
APP__JWT__SECRET=dev-only-hs256-secret-change-me-0000
# The team's Auth0 dev tenant (public identifiers): the app signs in there.
# For dev tokens instead (scripts/dev_token.py), set ALGORITHM=HS256 and
# empty the three below.
APP__JWT__ALGORITHM=RS256
APP__JWT__JWKS_URL=https://dev-3wpn13zh30l6orpi.us.auth0.com/.well-known/jwks.json
APP__JWT__AUDIENCE=https://api.hacksgiving.app
APP__JWT__ISSUER=https://dev-3wpn13zh30l6orpi.us.auth0.com/
# Auth0 (staging/production):
# APP__JWT__ALGORITHM=RS256
# APP__JWT__JWKS_URL=https://<tenant>.us.auth0.com/.well-known/jwks.json
# APP__JWT__ISSUER=https://<tenant>.us.auth0.com/
# APP__JWT__AUDIENCE=<Auth0 API identifier>

# Browser origins (JSON list). The iOS app doesn't need CORS.
# APP__CORS_ORIGINS=["http://localhost:8081"]

APP__ENVIRONMENT__NAME=dev

# OpenAI, for routing requests for help (POST /v1/route).
APP__OPENAI__API_KEY=
# APP__OPENAI__MODEL=gpt-5.4-mini
# APP__OPENAI__TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Voice debriefs: object storage for the audio, which is deleted as soon as
# it's transcribed. Production uses Supabase Storage (APP__STORAGE__BACKEND=
# supabase, set up by Terraform). Locally: the S3-compatible `storage`
# service in database/compose.yaml (keys = STORAGE_ACCESS_KEY / _SECRET_KEY
# in database/.env). PUBLIC_ENDPOINT_URL is what the phone uploads to: this
# machine's LAN or Tailscale address, since the phone can't reach localhost.
# Leave ENDPOINT_URL empty to turn voice off (typed debriefs still work).
APP__STORAGE__BACKEND=s3
APP__STORAGE__ENDPOINT_URL=http://localhost:8333
# scripts/dev-setup.sh fills this in with your Tailscale (or LAN) IP.
APP__STORAGE__PUBLIC_ENDPOINT_URL=
APP__STORAGE__ACCESS_KEY_ID=hacksgiving-local-storage
APP__STORAGE__SECRET_ACCESS_KEY=hacksgiving-local-storage-secret
APP__STORAGE__BUCKET=phantom-audio
APP__STORAGE__CREATE_BUCKET=true

# Anonymous voice integration. These values are server-only secrets and must
# never be exposed as EXPO_PUBLIC environment variables.
APP__VOICE__ELEVENLABS_WEBHOOK_SECRET=
APP__VOICE__TOOL_SECRET=
